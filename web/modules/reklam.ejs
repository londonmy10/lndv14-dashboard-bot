<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>LND Bot | Reklam Engelleme</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #0f172a; color: white; font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="p-10">
    <div class="max-w-4xl mx-auto">
        <div class="mb-6">
            <a href="/manage/<%= guild.id %>" class="text-blue-400 hover:text-blue-300 transition flex items-center font-medium">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Yönetim Paneline Dön
            </a>
        </div>

        <h1 class="text-4xl font-black mb-8 text-orange-500 tracking-tighter text-center">🚫 Reklam Engelleme</h1>

        <div class="glass p-8 rounded-3xl border border-white/10 shadow-2xl text-center">
            <p class="mb-8 text-gray-400 italic text-lg">Sunucuda reklam yapan kullanıcıları otomatik olarak sunucudan atar.</p>

            <% 
               // Veriyi çekiyoruz, eğer 'acik' ise true sayıyoruz
               const durumVerisi = db.get(`reklam_engelle_${guild.id}`);
               const isEnabled = durumVerisi === 'acik' || durumVerisi === true;
            %>

            <button onclick="reklamGuncelle('<%= isEnabled ? 'kapali' : 'acik' %>')" 
                class="w-full py-6 <%= isEnabled ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700' %> rounded-2xl font-black text-2xl transition shadow-xl transform active:scale-95">
                <%= isEnabled ? 'SİSTEMİ KAPAT' : 'SİSTEMİ ETKİNLEŞTİR' %>
            </button>
        </div>
    </div>

    <script>
        function reklamGuncelle(yeniDeger) {
            fetch(`/manage/<%= guild.id %>/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify([
                    { tip: 'reklam_engelle', deger: yeniDeger }
                ])
            }).then(res => {
                if(res.ok) {
                    alert('Reklam engelleme durumu başarıyla güncellendi!');
                    location.reload();
                } else {
                    alert('Hata: Ayar kaydedilemedi!');
                }
            });
        }
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>LND Bot | Koruma Sistemleri</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #0f172a; color: white; font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="p-10">
    <div class="max-w-4xl mx-auto">
        <!-- Üst Navigasyon -->
        <div class="mb-6">
            <a href="/manage/<%= guild.id %>" class="text-blue-400 hover:text-blue-300 transition flex items-center font-medium">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Yönetim Paneline Dön
            </a>
        </div>

        <h1 class="text-4xl font-black mt-4 mb-8 text-green-500 tracking-tighter">🛡️ Koruma Sistemleri</h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Kanal Koruma -->
            <% 
               const kanalVerisi = db.get(`kanal_koruma_${guild.id}`);
               const isKanalEnabled = kanalVerisi === 'acik' || kanalVerisi === true;
            %>
            <div class="glass p-8 rounded-3xl border border-white/10 text-center shadow-2xl relative overflow-hidden group">
                <div class="text-5xl mb-6 group-hover:scale-110 transition duration-500">📂</div>
                <h3 class="text-2xl font-black mb-2 uppercase tracking-tight">Kanal Koruma</h3>
                <p class="text-gray-500 text-sm mb-8 leading-relaxed">Kanalların izinsiz silinmesini veya değiştirilmesini engeller.</p>
                
                <button onclick="korumaGuncelle('kanal', '<%= isKanalEnabled ? 'kapali' : 'acik' %>')" 
                    class="w-full py-4 <%= isKanalEnabled ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700' %> rounded-2xl font-black text-lg transition transform active:scale-95 shadow-lg shadow-black/20">
                    <%= isKanalEnabled ? 'SİSTEMİ KAPAT' : 'SİSTEMİ AÇ' %>
                </button>
            </div>

            <!-- Rol Koruma -->
            <% 
               const rolVerisi = db.get(`rol_koruma_${guild.id}`);
               const isRolEnabled = rolVerisi === 'acik' || rolVerisi === true;
            %>
            <div class="glass p-8 rounded-3xl border border-white/10 text-center shadow-2xl relative overflow-hidden group">
                <div class="text-5xl mb-6 group-hover:scale-110 transition duration-500">🎭</div>
                <h3 class="text-2xl font-black mb-2 uppercase tracking-tight">Rol Koruma</h3>
                <p class="text-gray-500 text-sm mb-8 leading-relaxed">Rollerin izinsiz silinmesini veya yetkilerinin değiştirilmesini engeller.</p>
                
                <button onclick="korumaGuncelle('rol', '<%= isRolEnabled ? 'kapali' : 'acik' %>')" 
                    class="w-full py-4 <%= isRolEnabled ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700' %> rounded-2xl font-black text-lg transition transform active:scale-95 shadow-lg shadow-black/20">
                    <%= isRolEnabled ? 'SİSTEMİ KAPAT' : 'SİSTEMİ AÇ' %>
                </button>
            </div>
        </div>
    </div>

    <script>
        function korumaGuncelle(tip, yeniDeger) {
            // İlgili korumayı ve genel koruma sistem durumunu aynı anda güncelliyoruz
            const gonderilecekVeri = [
                { tip: `${tip}_koruma`, deger: yeniDeger }
            ];

            // Eğer herhangi bir koruma açılıyorsa genel sistemi de 'acik' yapalım
            if (yeniDeger === 'acik') {
                gonderilecekVeri.push({ tip: 'koruma_sistemi', deger: 'acik' });
            }

            fetch(`/manage/<%= guild.id %>/save`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(gonderilecekVeri)
            }).then(res => {
                if(res.ok) {
                    location.reload();
                } else {
                    alert('Ayarlar kaydedilemedi!');
                }
            });
        }
    </script>
</body>
</html>

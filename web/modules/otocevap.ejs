<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>LND Bot | Otomatik Cevap</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #0f172a; color: white; font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="p-10">
    <div class="max-w-4xl mx-auto">
        <div class="mb-6">
            <a href="/manage/<%= guild.id %>" class="text-blue-400 hover:text-blue-300 transition flex items-center font-medium">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Yönetim Paneline Dön
            </a>
        </div>

        <h1 class="text-4xl font-black mb-8 text-purple-500 tracking-tighter">💬 Otomatik Cevap Sistemi</h1>

        <div class="grid gap-8">
            <!-- Durum Kontrolü -->
            <div class="glass p-8 rounded-3xl border border-white/10 shadow-2xl text-center">
                <% 
                   const suankiDurum = db.get(`otocevap_sistemi_${guild.id}`);
                   const isEnabled = suankiDurum === 'acik' || suankiDurum === true;
                %>
                <button onclick="durumGuncelle('<%= isEnabled ? 'kapali' : 'acik' %>')" 
                    class="w-full py-5 <%= isEnabled ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700' %> rounded-2xl font-black text-xl transition transform active:scale-95 shadow-lg">
                    <%= isEnabled ? 'SİSTEMİ KAPAT' : 'SİSTEMİ ETKİNLEŞTİR' %>
                </button>
            </div>

            <!-- Yeni Cevap Ekleme -->
            <div class="glass p-8 rounded-3xl border border-white/10 shadow-2xl">
                <h3 class="text-xl font-bold mb-6 italic text-gray-300">Yeni Otomatik Cevap Ekle</h3>
                <div class="space-y-4">
                    <input type="text" id="soru" placeholder="Kullanıcı ne yazarsa? (Örn: sa)" class="w-full bg-slate-800 border border-white/10 p-4 rounded-xl outline-none focus:border-purple-500 text-white">
                    <input type="text" id="cevap" placeholder="Bot ne cevap versin? (Örn: Aleyküm Selam!)" class="w-full bg-slate-800 border border-white/10 p-4 rounded-xl outline-none focus:border-purple-500 text-white">
                    <button onclick="cevapEkle()" class="w-full py-4 bg-purple-600 hover:bg-purple-700 rounded-xl font-black transition">EKLE</button>
                </div>
            </div>

            <!-- Mevcut Cevaplar Listesi -->
            <div class="glass p-8 rounded-3xl border border-white/10 shadow-2xl">
                <h3 class="text-xl font-bold mb-6 text-gray-300">Mevcut Cevaplar</h3>
                <div class="space-y-3" id="cevapListesi">
                    <% 
                       const cevaplar = db.get(`otocevaplar_${guild.id}`) || [];
                       if(cevaplar.length === 0) { 
                    %>
                        <p class="text-gray-500 italic">Henüz hiç otomatik cevap eklenmemiş.</p>
                    <% } else { 
                        cevaplar.forEach((item, index) => { %>
                        <div class="flex justify-between items-center bg-white/5 p-4 rounded-xl border border-white/5">
                            <div>
                                <span class="text-purple-400 font-bold"><%= item.soru %></span> 
                                <span class="text-gray-600 mx-2">➔</span> 
                                <span class="text-gray-300"><%= item.cevap %></span>
                            </div>
                            <button onclick="cevapSil(<%= index %>)" class="text-red-500 hover:text-red-400 font-bold">SİL</button>
                        </div>
                    <% })} %>
                </div>
            </div>
        </div>
    </div>

    <script>
        function durumGuncelle(yeniDeger) {
            fetch(`/manage/<%= guild.id %>/save`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify([{ tip: 'otocevap_sistemi', deger: yeniDeger }])
            }).then(() => location.reload());
        }

        function cevapEkle() {
            const soru = document.getElementById('soru').value;
            const cevap = document.getElementById('cevap').value;
            if(!soru || !cevap) return alert('Lütfen tüm alanları doldur!');

            // Veritabanı yapına uygun olarak diziye ekleme yapıyoruz
            let mevcutlar = <%- JSON.stringify(db.get(`otocevaplar_${guild.id}`) || []) %>;
            mevcutlar.push({ soru, cevap });

            fetch(`/manage/<%= guild.id %>/save`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify([
                    { tip: 'otocevaplar', deger: mevcutlar },
                    { tip: 'otocevap_sistemi', deger: 'acik' }
                ])
            }).then(() => location.reload());
        }

        function cevapSil(index) {
            let mevcutlar = <%- JSON.stringify(db.get(`otocevaplar_${guild.id}`) || []) %>;
            mevcutlar.splice(index, 1);

            fetch(`/manage/<%= guild.id %>/save`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify([{ tip: 'otocevaplar', deger: mevcutlar }])
            }).then(() => location.reload());
        }
    </script>
</body>
</html>

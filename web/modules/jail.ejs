<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>LND Bot | Jail Sistemi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #0f172a; color: white; font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="p-10">
    <div class="max-w-4xl mx-auto">
        <!-- Üst Navigasyon -->
        <div class="mb-6">
            <a href="/manage/<%= guild.id %>" class="text-blue-400 hover:text-blue-300 transition flex items-center font-medium">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Yönetim Paneline Dön
            </a>
        </div>

        <h1 class="text-4xl font-black mb-8 text-red-500 tracking-tighter">⚖️ Jail Sistemi Ayarları</h1>

        <div class="grid gap-8">
            <!-- 1. Sistem Durumu (Aç/Kapat) -->
            <div class="glass p-8 rounded-3xl border border-white/10 shadow-2xl text-center">
                <label class="block text-sm font-bold text-gray-400 mb-4 uppercase tracking-widest text-left">Sistem Durumu</label>
                <% 
                   const suankiDurum = db.get(`jail_sistemi_${guild.id}`);
                   const isEnabled = suankiDurum === 'acik' || suankiDurum === true;
                %>
                <button onclick="durumGuncelle('<%= isEnabled ? 'kapali' : 'acik' %>')" 
                    class="w-full py-5 <%= isEnabled ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700' %> rounded-2xl font-black text-xl transition transform active:scale-95 shadow-lg">
                    <%= isEnabled ? 'SİSTEMİ TAMAMEN KAPAT' : 'SİSTEMİ ETKİNLEŞTİR' %>
                </button>
            </div>

            <!-- 2. Jail Ayarları -->
            <div class="glass p-8 rounded-3xl border border-white/10 shadow-2xl space-y-6">
                <!-- Jail Rolü -->
                <div>
                    <label class="block text-sm font-bold text-gray-400 mb-3 uppercase tracking-widest">Cezalı (Jail) Rolü</label>
                    <select id="jail_rol" class="w-full bg-slate-800 border border-white/10 p-4 rounded-xl outline-none focus:border-red-500 transition text-white">
                        <option value="">Rol Seçilmemiş</option>
                        <% guild.roles.cache.filter(r => r.name !== '@everyone').forEach(r => { %>
                            <option value="<%= r.id %>" <%= db.get(`jail_rol_${guild.id}`) === r.id ? 'selected' : '' %>><%= r.name %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Jail Yetkilisi Rolü -->
                <div>
                    <label class="block text-sm font-bold text-gray-400 mb-3 uppercase tracking-widest">Jail Yetkilisi Rolü</label>
                    <select id="jail_yetkili" class="w-full bg-slate-800 border border-white/10 p-4 rounded-xl outline-none focus:border-red-500 transition text-white">
                        <option value="">Rol Seçilmemiş</option>
                        <% guild.roles.cache.filter(r => r.name !== '@everyone').forEach(r => { %>
                            <option value="<%= r.id %>" <%= db.get(`jail_yetkili_${guild.id}`) === r.id ? 'selected' : '' %>><%= r.name %></option>
                        <% }) %>
                    </select>
                </div>

                <button onclick="jailKaydet()" class="w-full py-5 bg-red-600 rounded-2xl font-black text-xl hover:bg-red-700 transition shadow-lg shadow-red-600/20 transform active:scale-95">
                    AYARLARI GÜNCELLE
                </button>
            </div>
        </div>
    </div>

    <script>
        // Sadece Durum Değiştirme
        function durumGuncelle(yeniDeger) {
            fetch(`/manage/<%= guild.id %>/save`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify([
                    { tip: 'jail_sistemi', deger: yeniDeger }
                ])
            }).then(res => {
                if(res.ok) {
                    alert('Jail sistemi durumu güncellendi!');
                    location.reload();
                }
            });
        }

        // Genel Kayıt Fonksiyonu
        function jailKaydet() {
            const rol = document.getElementById('jail_rol').value;
            const yetkili = document.getElementById('jail_yetkili').value;

            if(!rol || !yetkili) return alert('Lütfen cezalı ve yetkili rollerini seç Hido!');

            fetch(`/manage/<%= guild.id %>/save`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify([
                    { tip: 'jail_rol', deger: rol },
                    { tip: 'jail_yetkili', deger: yetkili },
                    { tip: 'jail_sistemi', deger: 'acik' } // Kaydedince otomatik açılır
                ])
            }).then(res => {
                if(res.ok) {
                    alert('Jail ayarları başarıyla kaydedildi!');
                    location.reload();
                }
            });
        }
    </script>
</body>
</html>

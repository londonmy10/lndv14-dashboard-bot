<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>LND Bot | Seviye Sistemi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #0f172a; color: white; font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="p-10">
    <div class="max-w-4xl mx-auto">
        <!-- Üst Menü -->
        <div class="mb-6">
            <a href="/manage/<%= guild.id %>" class="text-blue-400 hover:text-blue-300 transition flex items-center font-medium">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Yönetim Paneline Dön
            </a>
        </div>

        <h1 class="text-4xl font-black mb-8 text-yellow-400 tracking-tighter">⭐ Seviye Sistemi Ayarları</h1>

        <div class="grid gap-8">
            <!-- 1. Durum Kontrol Kartı -->
            <div class="glass p-8 rounded-3xl border border-white/10 shadow-2xl text-center">
                <label class="block text-sm font-bold text-gray-400 mb-4 uppercase tracking-widest text-left">Sistem Durumu</label>
                <% 
                   const suankiDurum = db.get(`seviye_sistemi_${guild.id}`);
                   const isEnabled = suankiDurum === 'acik' || suankiDurum === true;
                %>
                <button onclick="durumDegistir('<%= isEnabled ? 'kapali' : 'acik' %>')" 
                    class="w-full py-5 <%= isEnabled ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700' %> rounded-2xl font-black text-xl transition transform active:scale-95 shadow-lg">
                    <%= isEnabled ? 'SİSTEMİ DEVRE DIŞI BIRAK' : 'SİSTEMİ ETKİNLEŞTİR' %>
                </button>
            </div>

            <!-- 2. Kanal Ayar Kartı -->
            <div class="glass p-8 rounded-3xl border border-white/10 shadow-2xl">
                <label class="block text-sm font-bold text-gray-400 mb-4 uppercase tracking-widest">Seviye Log Kanalı</label>
                <p class="text-sm text-gray-500 mb-6 italic">Kullanıcılar seviye atladığında tebrik mesajının gideceği kanalı seçin.</p>
                
                <select id="seviye_log" class="w-full bg-slate-800 border border-white/10 p-4 rounded-xl outline-none focus:border-yellow-500 transition text-white">
                    <option value="">Kanal Seçilmemiş</option>
                    <% guild.channels.cache.filter(c => c.type === 0).forEach(c => { %>
                        <option value="<%= c.id %>" <%= db.get(`seviye_log_${guild.id}`) === c.id ? 'selected' : '' %>># <%= c.name %></option>
                    <% }) %>
                </select>

                <button onclick="kanalKaydet()" class="w-full mt-6 py-4 bg-white/5 border border-white/10 rounded-xl font-bold hover:bg-white/10 transition">
                    KANALI KAYDET
                </button>
            </div>
        </div>
    </div>

    <script>
        // Sadece Durumu Açıp Kapatan Fonksiyon
        function durumDegistir(yeniDeger) {
            fetch(`/manage/<%= guild.id %>/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify([
                    { tip: 'seviye_sistemi', deger: yeniDeger }
                ])
            }).then(res => {
                if(res.ok) {
                    alert('Seviye sistemi durumu güncellendi!');
                    location.reload();
                }
            });
        }

        // Kanalı Ayarlayan Fonksiyon
        function kanalKaydet() {
            const kanal = document.getElementById('seviye_log').value;
            if(!kanal) return alert('Lütfen bir kanal seç, Hido!');

            fetch(`/manage/<%= guild.id %>/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify([
                    { tip: 'seviye_log', deger: kanal },
                    { tip: 'seviye_sistemi', deger: 'acik' } // Kanal seçilince sistemi otomatik açar
                ])
            }).then(res => {
                if(res.ok) {
                    alert('Seviye kanalı başarıyla ayarlandı!');
                    location.reload();
                }
            });
        }
    </script>
</body>
</html>
